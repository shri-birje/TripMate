# Copy this file to ".env" (which is git-ignored) and fill in real values.
# NEVER commit the real .env file. This example file contains names only.

# development | test | staging | production
APP_ENV=development

# Port for the local API server
PORT=8787

# Comma-separated list of web origins allowed to call the API (CORS).
# Expo web dev server runs on 8081 by default.
CORS_ORIGINS=http://localhost:8081

# debug | info | warn | error
LOG_LEVEL=info

# Supabase (added when the database milestone starts; leave empty until then)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
