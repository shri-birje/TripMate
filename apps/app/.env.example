# Copy to ".env" (git-ignored) and fill in. Names only here - no secrets.
#
# IMPORTANT: every variable starting with EXPO_PUBLIC_ is baked into the app
# and website bundle and is visible to anyone. Only PUBLIC values go here.

# --- TripMate API ---------------------------------------------------------
#  - Web on the same computer:      http://localhost:8787
#  - Android emulator:              http://10.0.2.2:8787
#  - Real phone (Expo Go):          http://<your-computer-LAN-IP>:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# --- Supabase (accounts and database) -------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> API (or "Data API").
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key only (starts with sb_publishable_). It is designed to be
# public: it can only do what the database's security rules allow.
#
# NEVER put the SECRET key (sb_secret_...) or a "service_role" key here. The
# app refuses to start if it detects one.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
