{
  "name": "@tripmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TripMate REST API (Hono). Runs on Node locally; runtime-agnostic so it can deploy to a free edge host.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@tripmate/core": "*",
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  }
}
